# ==============================================================================
# EduDuty Backend Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env' before running the application:
#   PowerShell: Copy-Item backend\.env.example backend\.env
#   Bash:       cp backend/.env.example backend/.env
#
# IMPORTANT SECURITY NOTICE:
# - Never commit 'backend/.env' or any file containing real credentials to git.
# - Production deployments MUST set APP_ENV=production, ENABLE_DEV_DEMO_AUTH=false,
#   and use high-entropy secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# For local development and demonstration, use the demo SQLite database.
# Never point DATABASE_URL to 'eduduty.db' directly.
DATABASE_URL=sqlite:///./eduduty_demo.db

# Optional: Dedicated PostgreSQL URL (for production or PostgreSQL RLS test suite)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:54322/postgres

# Optional: Dedicated read-only database URL for AI read queries (Mandatory in production PostgreSQL)
# AI_READER_DATABASE_URL=postgresql+psycopg://eduduty_ai_reader:reader_password@localhost:54322/postgres

# ------------------------------------------------------------------------------
# 2. Environment & Application Mode
# ------------------------------------------------------------------------------
# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Application environment gate ('development', 'test', or 'production')
# Setting APP_ENV=production enforces strict security gates and disables demo auth.
APP_ENV=development

# ------------------------------------------------------------------------------
# 3. Authentication & Supabase Configuration
# ------------------------------------------------------------------------------
# Secret key used to verify Supabase JWT signatures (minimum 16 characters).
# In production, replace with your production Supabase project's JWT secret.
SUPABASE_JWT_SECRET=dev-jwt-secret-placeholder-min-16-chars-long

# Expected JWT issuer claim ('iss')
SUPABASE_JWT_ISSUER=https://test.supabase.co/auth/v1

# Expected JWT audience claim ('aud')
SUPABASE_JWT_AUDIENCE=authenticated

# Allowed JWT signing algorithms (comma-separated, e.g. HS256 or RS256)
SUPABASE_JWT_ALGORITHM=HS256

# Optional: Supabase project public URL (fallback for issuer resolution)
# SUPABASE_URL=https://your-project.supabase.co

# Development Demo Authentication toggle:
# Enables predefined demo identities on /auth/demo-login for local development.
# SAFEGUARD: Automatically hard-disabled if APP_ENV=production or ENVIRONMENT=production.
# In production, this MUST be set to false.
ENABLE_DEV_DEMO_AUTH=true

# ------------------------------------------------------------------------------
# 4. CORS Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser access
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Optional AI Service Providers (Inference & Reporting)
# ------------------------------------------------------------------------------
# Active AI providers in priority order (comma-separated: groq, gemini, ollama)
# AI_PROVIDERS=groq,gemini,ollama

# Groq API configuration (https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini API configuration (https://aistudio.google.com/)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Local Ollama configuration
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2:2b

# ------------------------------------------------------------------------------
# 6. PostgreSQL Row-Level Security (RLS) & Security Gating (Optional / Production)
# ------------------------------------------------------------------------------
# High-entropy secret (minimum 32 characters) for minting HMAC-signed identity context
# Required only when running with PostgreSQL RLS.
# EDUDUTY_RLS_HMAC_SECRET=replace-with-a-secure-high-entropy-signing-key-min-32-chars

# Strict safety gate for AI freeform SQL read queries (defaults to false)
# ENABLE_FREEFORM_SQL_READ=false
