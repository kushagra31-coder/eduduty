# Database connection string
# Local SQLite default: sqlite:///./eduduty.db
# PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:54322/postgres
DATABASE_URL=sqlite:///./eduduty.db

# Environment mode ('local', 'staging', 'production')
ENV=local
AUTH_DISABLED=false

# Authentication Secrets (JWT / Supabase)
JWT_SECRET=replace-with-a-secure-secret-key-at-least-32-chars
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# CORS configuration (comma-separated origins, no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Configuration
# When AI_ALLOW_CLOUD is false (default), only local Ollama is queried
AI_ALLOW_CLOUD=false
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
