# Local development and demonstration database URL
DATABASE_URL=sqlite:///./eduduty_demo.db

# AI Provider Keys
# Get a free Groq key at https://console.groq.com/keys
# GROQ_API_KEY=your_key_here

# Or use Gemini if you prefer (get key at https://aistudio.google.com/)
# GEMINI_API_KEY=your_key_here

# Local Development Authentication Settings
# In production, set SUPABASE_JWT_SECRET to your live Supabase project's secret and set ENABLE_DEV_DEMO_AUTH=false
ENVIRONMENT=development
APP_ENV=development
SUPABASE_JWT_SECRET=test-jwt-secret-key-32-chars-long-eduduty-test-key-12345
SUPABASE_JWT_ISSUER=https://test.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
ENABLE_DEV_DEMO_AUTH=true

