# Local Supabase default PostgreSQL connection string
# Supabase typically runs on port 54322 locally
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# AI Provider Keys
# Get a free Groq key at https://console.groq.com/keys
# GROQ_API_KEY=your_key_here

# Or use Gemini if you prefer (get key at https://aistudio.google.com/)
# GEMINI_API_KEY=your_key_here
